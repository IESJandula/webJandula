generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Noticia {
  id             Int      @id @default(autoincrement())
  titulo         String
  subtitulo      String?
  cuerpo         String
  categoria      String   @default("Centro")
  portada        String?
  galeria        String   @default("[]") // JSON array de rutas
  fecha          DateTime @default(now())
  autor          String
  autorEmail     String
  estado         String   @default("pendiente") // pendiente | publicada | rechazada
  motivoRechazo  String?
  // Noticias ancladas: aparecen al principio de la web pública, por encima de
  // las demás, hasta que un administrador las desancla. Publicar una noticia
  // nueva NO desplaza a las ancladas.
  fijada         Boolean  @default(false)
  // Posición manual dentro de la web pública (0 = primera). Se fija
  // arrastrando en el panel y vale para cualquier noticia publicada, anclada
  // o no; las ancladas se muestran antes que el resto sea cual sea su número.
  // Una noticia recién publicada entra al principio de las no ancladas.
  orden          Int      @default(0)
  // Cambios que el autor propone sobre una noticia YA publicada. Se guardan
  // aparte (JSON con titulo, subtitulo, cuerpo, categoria, portada y galeria)
  // para que la web siga enseñando lo aprobado hasta que un administrador
  // revise: editar no debe cambiar por la espalda lo que ya leen las familias.
  revision       String?
  revisionFecha  DateTime?
  // Motivo del ultimo rechazo de cambios, para que el autor sepa que corregir.
  revisionMotivo String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
