---
// src/components/CardNoticiaRelacionada.astro
//
// Version compacta para la barra lateral de la ficha de noticia: miniatura
// pequena y titular al lado. En una columna estrecha, apilar tarjetas grandes
// competia con el articulo que se esta leyendo.

interface Props {
    title: string;
    date: string;
    image: string;
    link: string;
}

const { title, date, image, link } = Astro.props;

const meses = [
    'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
    'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
];
const fechaObj = new Date(date);
const fechaLegible = Number.isNaN(fechaObj.getTime())
    ? date
    : `${fechaObj.getDate()} de ${meses[fechaObj.getMonth()]} de ${fechaObj.getFullYear()}`;
---

<a
    href={link}
    class="group flex items-start gap-4 rounded-xl p-2 -mx-2 transition-colors hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
>
    <img
        src={image}
        alt=""
        class="h-16 w-20 flex-shrink-0 rounded-lg bg-slate-100 object-cover"
        loading="lazy"
        decoding="async"
    />

    <div class="min-w-0">
        <time datetime={date} class="text-xs text-slate-500 tabular-nums">
            {fechaLegible}
        </time>
        <h4
            class="mt-1 text-[15px] font-semibold leading-snug text-slate-900 line-clamp-3 transition-colors group-hover:text-blue-800"
            style="font-family: 'Newsreader', Georgia, serif;"
        >
            {title}
        </h4>
    </div>
</a>
