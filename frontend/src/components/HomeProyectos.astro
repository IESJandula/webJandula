---
import SectionHeader from './SectionHeader.astro';
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <SectionHeader
      eyebrow="Proyectos"
      eyebrowClass="bg-orange-50 text-orange-700"
      title="Aprendemos haciendo"
      subtitle="Proyectos innovadores que enriquecen la formación de nuestro alumnado"
    />

    <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      <article class="group min-h-[200px] rounded-[24px] bg-gradient-to-br from-blue-600 to-indigo-700 p-6 text-white shadow-[0_16px_24px_rgba(59,130,246,0.14)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_18px_28px_rgba(59,130,246,0.16)]">
        <div class="relative z-10 flex h-full flex-col justify-center">
          <h3 class="text-[2rem] font-black leading-none">Proyecto LINCE</h3>
          <p class="mt-3 max-w-[17rem] text-base leading-relaxed text-blue-100">Participación en Shell Eco Marathon con vehículo de alta eficiencia.</p>
        </div>
      </article>

      <article class="group min-h-[200px] rounded-[24px] bg-gradient-to-br from-violet-600 via-purple-600 to-pink-600 p-6 text-white shadow-[0_16px_24px_rgba(168,85,247,0.14)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_18px_28px_rgba(168,85,247,0.16)]">
        <div class="relative z-10 flex h-full flex-col justify-center">
          <h3 class="text-[2rem] font-black leading-none">Revista "Pasa Página"</h3>
          <p class="mt-3 max-w-[18rem] text-base leading-relaxed text-purple-100">Espacio de lectura, cultura y publicación de revista escolar.</p>
        </div>
      </article>

      <article class="group min-h-[200px] rounded-[24px] bg-gradient-to-br from-amber-500 via-orange-500 to-orange-600 p-6 text-white shadow-[0_16px_24px_rgba(249,115,22,0.14)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_18px_28px_rgba(249,115,22,0.16)]">
        <div class="relative z-10 flex h-full flex-col justify-center">
          <h3 class="text-[2rem] font-black leading-none">Biblioteca</h3>
          <p class="mt-3 max-w-[17rem] text-base leading-relaxed text-amber-50">Espacio de lectura, investigación y aprendizaje para toda la comunidad.</p>
        </div>
      </article>
    </div>

    <div class="text-center mt-12">
      <a href="/proyectos" class="inline-block bg-orange-500 text-white px-8 py-3 rounded-full font-semibold shadow-[0_12px_22px_rgba(249,115,22,0.22)] hover:bg-orange-600 transition-all duration-200">
        Ver todos los proyectos
      </a>
    </div>
  </div>
</section>
