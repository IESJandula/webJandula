---
/**
 * La ficha de una noticia.
 *
 * La usan dos paginas: la version construida de cada noticia (noticias/[id])
 * y la de reserva (noticias/ver), que atiende a las noticias publicadas
 * despues del ultimo build. Cada pieza que puede cambiar al editar lleva un
 * data-articulo: con eso, articuloEnVivo.ts la pone al dia en el navegador sin
 * reconstruir la web.
 *
 * Composicion: cintillo, titulo, entradilla, imagen y cuerpo comparten un
 * unico eje y la misma medida de lectura. Antes habia tres anchos distintos
 * (cabecera centrada, imagen a todo el contenedor y cuerpo pegado a la
 * izquierda por una barra lateral), y el ojo perdia la columna al bajar.
 */
import CardNoticia from '@/components/CardNoticia.astro';
import { formatearFecha, calcularEntradilla, figuraGaleriaHTML } from '@/lib/articuloNoticia';
import type { NoticiaCard, NoticiaDetail } from '@/lib/api';

interface Props {
    noticia: NoticiaDetail | null;
    /** Otras noticias, al pie. La pagina de reserva no trae ninguna. */
    relacionadas?: NoticiaCard[];
    /** Pagina de reserva: aun no se sabe que noticia toca, se rellena luego. */
    cargando?: boolean;
}

const { noticia, relacionadas = [], cargando = false } = Astro.props;

const fechaLegible = noticia ? formatearFecha(noticia.date) : '';
const entradilla = calcularEntradilla(noticia?.summary, noticia?.body);
const sidePoster = noticia?.poster ?? null;
const bottomGallery = noticia?.gallery ?? [];
---

<section id="articulo-no-disponible" class:list={['bg-slate-50 py-20', (noticia || cargando) && 'hidden']}>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-sm">
      <h1 class="text-2xl md:text-3xl font-bold text-slate-900">Noticia no disponible</h1>
      <p class="mt-3 text-slate-600">
        Ahora mismo no se puede cargar esta noticia. Vuelve a intentarlo en unos minutos.
      </p>
      <a
        href="/noticias"
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100"
      >
        <span aria-hidden="true">&#8592;</span>
        Volver a noticias
      </a>
    </div>
  </div>
</section>

<article id="articulo-noticia" class:list={['bg-white', !noticia && 'hidden']} data-noticia-id={noticia?.id ?? ''}>
  <header class="container mx-auto px-4 pt-10 md:pt-16">
    <div class="mx-auto max-w-[68ch]">
      <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs uppercase tracking-[0.14em] text-slate-500">
        <span
          data-articulo="categoria"
          class:list={['font-semibold text-slate-700', !noticia?.category && 'hidden']}
        >{noticia?.category}</span>
        <span
          data-articulo="categoria-separador"
          aria-hidden="true"
          class:list={['text-slate-300', !noticia?.category && 'hidden']}
        >&#183;</span>
        <time data-articulo="fecha" datetime={noticia?.date ?? ''} class="tabular-nums">{fechaLegible}</time>
      </p>

      <h1
        data-articulo="titulo"
        class="mt-5 text-3xl font-semibold leading-[1.12] text-slate-900 md:text-[2.75rem]"
        style="font-family: 'Newsreader', Georgia, serif; letter-spacing: -0.02em; text-wrap: balance;"
      >
        {noticia?.title}
      </h1>

      <p
        data-articulo="entradilla"
        class:list={['mt-5 text-lg leading-relaxed text-slate-600 md:text-xl', !entradilla && 'hidden']}
        style="text-wrap: pretty;"
      >{entradilla}</p>
    </div>
  </header>

  <!-- El cartel del tablon, tratado como tal: en su propia banda y ampliable.
       Casi todos los avisos del centro son carteles verticales con horarios y
       aulas en letra pequena, asi que poder abrirlos a pantalla completa vale
       mas que cualquier adorno. El alto lo pone la ventana y no un valor fijo;
       al no fijar el ancho, una imagen pequena nunca se amplia ni se pixela. -->
  <figure
    data-articulo="portada-banda"
    class:list={[
      'mb-10 mt-8 border-y border-slate-200 bg-slate-50 py-8 md:mb-14 md:mt-10 md:py-12',
      !noticia?.image && 'hidden',
    ]}
  >
    <div class="container mx-auto px-4">
      <button
        data-articulo="portada-boton"
        class="gallery-image-trigger mx-auto block cursor-zoom-in rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-4 focus-visible:ring-offset-slate-50"
        data-image={noticia?.image}
        data-alt={`Imagen de la noticia: ${noticia?.title ?? ''}`}
        aria-label="Ver la imagen a pantalla completa"
      >
        <img
          data-articulo="portada"
          src={noticia?.image}
          alt={`Imagen de la noticia: ${noticia?.title ?? ''}`}
          class="mx-auto max-h-[75vh] w-auto max-w-full rounded-xl bg-white object-contain shadow-sm ring-1 ring-slate-200"
          loading="eager"
          decoding="async"
        />
      </button>
      <figcaption class="mt-4 text-center text-sm text-slate-500">Pulsa para ampliar</figcaption>
    </div>
  </figure>

  <div class="container mx-auto px-4 pb-14 md:pb-20">
    <div class="mx-auto max-w-[68ch]">
      <h2 class="sr-only">Contenido de la noticia</h2>

      <div data-articulo="cuerpo" class="news-richtext" set:html={noticia?.body}></div>

      <figure
        data-articulo="cartel"
        class:list={['mx-auto mt-10 max-w-md overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200', !sidePoster && 'hidden']}
      >
        <button
          class="gallery-image-trigger block w-full cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
          data-image={sidePoster}
          data-alt={`Cartel del evento: ${noticia?.title ?? ''}`}
          aria-label="Ver el cartel a pantalla completa"
        >
          <img
            src={sidePoster}
            alt={`Cartel del evento: ${noticia?.title ?? ''}`}
            class="h-auto w-full bg-white object-contain transition-transform duration-300 hover:scale-[1.01]"
            loading="lazy"
            decoding="async"
          />
        </button>
      </figure>

      <section data-articulo="galeria-seccion" class:list={['mt-14', bottomGallery.length === 0 && 'hidden']}>
        <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Galería</h2>
        <div data-articulo="galeria" class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {bottomGallery.map((src, index) => (
            <Fragment set:html={figuraGaleriaHTML(src, noticia?.title ?? '', index)} />
          ))}
        </div>
      </section>
    </div>

    {relacionadas.length > 0 && (
      <section class="mx-auto mt-16 max-w-6xl border-t border-slate-200 pt-12 md:mt-20">
        <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Más noticias del centro</h2>
        <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3">
          {relacionadas.map((item) => (
            <CardNoticia
              title={item.title}
              summary={item.summary}
              date={formatearFecha(item.date)}
              image={item.image}
              category={item.category}
              link={`/noticias/${item.id}`}
            />
          ))}
        </div>
      </section>
    )}

    <div class="mt-14 flex justify-center">
      <a
        href="/noticias"
        class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 transition-colors hover:border-slate-900 hover:bg-slate-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
      >
        <span aria-hidden="true">&#8592;</span>
        Volver a todas las noticias
      </a>
    </div>
  </div>
</article>

<div id="gallery-lightbox" class="fixed inset-0 z-[9999] hidden bg-black/85 p-4 md:p-8">
  <button
    id="gallery-lightbox-close"
    class="absolute top-4 right-4 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold text-white hover:bg-white/25"
    aria-label="Cerrar visor"
  >
    Cerrar
  </button>
  <div class="h-full w-full flex items-center justify-center">
    <img id="gallery-lightbox-image" alt="" class="max-h-full max-w-full object-contain" />
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImage = document.getElementById('gallery-lightbox-image') as HTMLImageElement | null;
    const closeButton = document.getElementById('gallery-lightbox-close');

    if (!lightbox || !lightboxImage) return;

    const closeLightbox = () => {
      lightbox.classList.add('hidden');
      lightboxImage.src = '';
      lightboxImage.alt = '';
    };

    // Delegado en el documento y no atado a cada boton: la galeria se vuelve
    // a pintar cuando se edita la noticia, y los manejadores se irian con los
    // nodos antiguos.
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement)?.closest?.('.gallery-image-trigger');
      if (!trigger) return;

      const src = trigger.getAttribute('data-image');
      const alt = trigger.getAttribute('data-alt') ?? 'Imagen ampliada';
      if (!src) return;

      lightboxImage.src = src;
      lightboxImage.alt = alt;
      lightbox.classList.remove('hidden');
    });

    closeButton?.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeLightbox();
    });
  });
</script>
