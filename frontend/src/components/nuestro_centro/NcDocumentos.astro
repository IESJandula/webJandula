---
import programaciones from './programaciones.json';

const apartados = [
  {
    titulo: 'Proyecto de dirección',
    descripcion: 'Las líneas de actuación y los objetivos de la dirección del centro.',
    documentos: [{ nombre: 'Proyecto de dirección' }],
  },
  {
    titulo: 'Plan de centro',
    descripcion: 'Los documentos que organizan la vida y la actividad educativa del instituto.',
    documentos: [
      { nombre: 'Proyecto educativo de centro (PEC)', href: '/documentos/proyecto-educativo-centro.pdf' },
      { nombre: 'Reglamento de organización y funcionamiento (ROF)', href: '/documentos/reglamento-organizacion-funcionamiento.pdf' },
      { nombre: 'Proyecto de gestión', href: '/documentos/proyecto-gestion.pdf' },
    ],
  },
];
---

<section id="documentos" class="py-24 bg-slate-50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Documentos del centro</h2>
      <p class="mt-4 text-lg leading-8 text-slate-600">
        Consulta los proyectos, los planes y las programaciones que guían la actividad del IES Jándula.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      {apartados.map((apartado, index) => (
        <article class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <span aria-hidden="true" class="mb-5 inline-flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700">
            {index + 1}
          </span>
          <h3 class="text-xl font-semibold text-slate-900">{apartado.titulo}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{apartado.descripcion}</p>
          {apartado.documentos.length > 0 && (
            <ul class="mt-5 space-y-3 text-sm text-slate-700">
              {apartado.documentos.map((documento) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>
                  {documento.href ? (
                    <a href={documento.href} target="_blank" rel="noopener" class="font-medium text-blue-700 hover:text-blue-900 hover:underline">
                      {documento.nombre} <span class="text-xs font-normal text-slate-400">PDF</span>
                    </a>
                  ) : (
                    <span>{documento.nombre}</span>
                  )}
                </li>
              ))}
            </ul>
          )}
          {(apartado.documentos.length === 0 || apartado.documentos.some((documento) => !documento.href)) && (
            <div class="mt-auto pt-6">
              <p class="rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-500">Pendiente de publicación</p>
            </div>
          )}
        </article>
      ))}

      <article class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 lg:col-span-2">
        <span aria-hidden="true" class="mb-5 inline-flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700">
          {apartados.length + 1}
        </span>
        <h3 class="text-xl font-semibold text-slate-900">Programaciones didácticas</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Consulta las programaciones del curso 2026-27 en PDF, organizadas por departamento didáctico.</p>
        <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 lg:items-start">
          {programaciones.map((departamento) => (
            <details class="group rounded-xl bg-slate-50 ring-1 ring-slate-200">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-medium text-slate-800 [&::-webkit-details-marker]:hidden">
                <span>{departamento.nombre}</span>
                <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
              </summary>
              <div class="space-y-4 px-4 pb-4">
                {departamento.grupos.map((grupo) => (
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{grupo.nombre}</p>
                    <ul class="mt-2 space-y-2 text-sm">
                      {grupo.documentos.map((documento) => (
                        <li>
                          <a href={documento.href} target="_blank" rel="noopener" class="text-blue-700 hover:text-blue-900 hover:underline">{documento.nombre}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>
