---
const apartados = [
  {
    titulo: 'Proyecto de dirección',
    descripcion: 'Las líneas de actuación y los objetivos de la dirección del centro.',
    documentos: ['Proyecto de dirección'],
  },
  {
    titulo: 'Plan de centro',
    descripcion: 'Los documentos que organizan la vida y la actividad educativa del instituto.',
    documentos: [
      'Proyecto educativo de centro (PEC)',
      'Reglamento de organización y funcionamiento (ROF)',
      'Proyecto de gestión',
    ],
  },
  {
    titulo: 'Programaciones didácticas',
    descripcion: 'Consulta las programaciones en PDF, organizadas por departamento didáctico.',
    documentos: [],
  },
];
---

<section id="documentos" class="py-24 bg-slate-50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Documentos del centro</h2>
      <p class="mt-4 text-lg leading-8 text-slate-600">
        Consulta los proyectos, los planes y las programaciones que guían la actividad del IES Jándula.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {apartados.map((apartado, index) => (
        <article class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <span aria-hidden="true" class="mb-5 inline-flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700">
            {index + 1}
          </span>
          <h3 class="text-xl font-semibold text-slate-900">{apartado.titulo}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{apartado.descripcion}</p>
          {apartado.documentos.length > 0 && (
            <ul class="mt-5 space-y-3 text-sm text-slate-700">
              {apartado.documentos.map((documento) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>
                  <span>{documento}</span>
                </li>
              ))}
            </ul>
          )}
          <div class="mt-auto pt-6">
            <p class="rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-500">Pendiente de publicación</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
