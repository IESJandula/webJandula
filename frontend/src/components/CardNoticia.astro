---
// src/components/CardNoticia.astro
import { getCategoriaStyle } from '@/lib/categorias';

interface Props {
    title: string;
    summary: string;
    date: string;
    image: string;
    category: string;
    link: string;
    variant?: 'default' | 'featured';
    /** Anclada por un administrador: se marca como destacada. */
    fijada?: boolean;
}

const { title, summary, date, image, category, link, variant = 'default', fijada = false } = Astro.props;
const isFeatured = variant === 'featured';
const categoriaStyle = getCategoriaStyle(category);
---

<article class="group flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm ring-1 ring-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 h-full">

    <!-- ── Imagen ──────────────────────────────── -->
    <div class={`relative ${isFeatured ? 'h-64 md:h-72' : 'h-52'} flex-shrink-0 overflow-hidden`}>
        <img
            src={image}
            alt={`Fotografía de la noticia: ${title}`}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
        />
        <!-- Gradiente para legibilidad -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/5 to-transparent pointer-events-none" aria-hidden="true"></div>

        <!-- Badge categoría -->
        <span
            class={`absolute top-3 left-3 inline-flex items-center gap-1.5 backdrop-blur-sm text-[11px] font-bold px-2.5 py-1 rounded-full ring-1 uppercase tracking-wide shadow-sm ${categoriaStyle.badge}`}
            aria-hidden="true"
        >
            <span class={`h-1.5 w-1.5 rounded-full ${categoriaStyle.dot}`}></span>
            {category}
        </span>

        <!-- Distintivo de noticia anclada por el centro -->
        {fijada && (
            <span class="absolute top-3 right-3 inline-flex items-center gap-1 rounded-full bg-amber-400/95 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-amber-950 shadow-sm ring-1 ring-amber-500/40 backdrop-blur-sm">
                <svg class="h-3 w-3 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.364 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.367 2.446c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.05 9.385c-.783-.57-.38-1.81.588-1.81h4.163a1 1 0 00.95-.69l1.286-3.958z" />
                </svg>
                Destacada
            </span>
        )}

        <!-- Fecha flotante sobre la imagen -->
        <time
            datetime={date}
            class="absolute bottom-3 right-3 inline-flex items-center gap-1.5 text-white/90 text-[11px] font-medium bg-black/40 backdrop-blur-sm px-2.5 py-1 rounded-full"
        >
            <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            {date}
        </time>
    </div>

    <!-- ── Contenido ───────────────────────────── -->
    <div class={`flex flex-col flex-grow ${isFeatured ? 'p-6 gap-3' : 'p-5 gap-2.5'}`}>

        <h3 class={`${isFeatured ? 'text-lg md:text-xl' : 'text-[15px]'} font-bold text-gray-900 leading-snug line-clamp-2 group-hover:text-blue-700 transition-colors`}>
            <a
                href={link}
                class="focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 rounded"
            >
                {title}
            </a>
        </h3>

        <p class={`${isFeatured ? 'text-[15px] line-clamp-4' : 'text-sm line-clamp-3'} text-gray-500 leading-relaxed flex-grow`}>
            {summary}
        </p>

        <!-- CTA -->
        <div class="pt-3 mt-auto border-t border-gray-100">
            <a
                href={link}
                aria-label={`Leer noticia completa: ${title}`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 hover:text-blue-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded"
            >
                Leer noticia
                <svg
                    class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                    fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                </svg>
            </a>
        </div>
    </div>
</article>

