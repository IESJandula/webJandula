---
import Layout from '@/layouts/Layout.astro';
import ArticuloNoticia from '@/components/ArticuloNoticia.astro';
import { getNoticiaById, getNoticiasIds, getNoticias } from '@/lib/api';

export async function getStaticPaths() {
  const ids = await getNoticiasIds(200);
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const noticia = id ? await getNoticiaById(id) : null;

// Las tres noticias del pie. Antes esto pedia el detalle de CADA noticia una
// por una (con 12 noticias son 144 peticiones por build); el listado ya trae
// todo lo que hace falta: titulo, fecha, imagen y categoria.
//
// Primero las de la misma categoria y, si no llegan a tres, se completan con
// las mas recientes: una ficha del tablon no deberia terminar en un hueco.
const candidatas = noticia
  ? (await getNoticias(24)).filter((item) => item.id !== id)
  : [];

const mismaCategoria = candidatas.filter((item) => item.category === noticia?.category);
const resto = candidatas.filter((item) => item.category !== noticia?.category);

const relacionadas = [...mismaCategoria, ...resto].slice(0, 3);
---

<Layout title={noticia?.title ?? 'Noticia no disponible'}>
  <ArticuloNoticia noticia={noticia} relacionadas={relacionadas} />

  <script>
    // Esta pagina se construyo con el contenido que habia entonces. Si despues
    // se ha editado la noticia (o se ha borrado), esto lo corrige al abrirla.
    import { refrescarArticulo } from '@/lib/articuloEnVivo';

    refrescarArticulo();
  </script>
</Layout>
