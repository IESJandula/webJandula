---
import Layout from '@/layouts/Layout.astro';
import ArticuloNoticia from '@/components/ArticuloNoticia.astro';
import { getNoticiaById, getNoticiasIds, getNoticias } from '@/lib/api';

export async function getStaticPaths() {
  const ids = await getNoticiasIds(200);
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const noticia = id ? await getNoticiaById(id) : null;

// Candidatas para la barra lateral. Antes esto pedia el detalle de CADA noticia
// una por una (con 12 noticias son 144 peticiones por build); el listado ya trae
// todo lo que necesita la barra lateral: titulo, fecha, imagen y categoria.
const relatedPool = noticia
  ? (await getNoticias(24)).filter((item) => item.id !== id)
  : [];

const sameCategory = noticia
  ? relatedPool.filter((item) => item.category === noticia.category)
  : [];

const relacionadas = (sameCategory.length > 0 ? sameCategory : relatedPool).slice(0, 4);

// "Te puede interesar" — fila inferior estilo periódico digital, distinta de la sidebar
const relatedIds = new Set(relacionadas.map((item) => item.id));
const recientes = noticia ? await getNoticias(8) : [];
const recomendadas = recientes
  .filter((item) => item.id !== id && !relatedIds.has(item.id))
  .slice(0, 3);
---

<Layout title={noticia?.title ?? 'Noticia no disponible'}>
  <ArticuloNoticia noticia={noticia} relacionadas={relacionadas} recomendadas={recomendadas} />

  <script>
    // Esta pagina se construyo con el contenido que habia entonces. Si despues
    // se ha editado la noticia (o se ha borrado), esto lo corrige al abrirla.
    import { refrescarArticulo } from '@/lib/articuloEnVivo';

    refrescarArticulo();
  </script>
</Layout>
